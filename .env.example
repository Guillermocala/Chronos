# Copia este archivo a .env.local (o usa `npx vercel env pull .env.local`).
# Nunca subas valores reales al repositorio.

# --- Supabase (Project Settings → Data API / API Keys) ---
# Ambas son públicas por diseño (van al navegador); en Vercel usar visibilidad "config".
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# --- Acceso: correos autorizados, separados por comas. El PRIMERO es el dueño (backups).
# Cada usuario ve solo sus propios datos. (ALLOWED_EMAIL, uno solo, sigue funcionando.) ---
ALLOWED_EMAILS=

# --- Backups manuales (Ajustes → Backups): token fine-grained con "Actions: Read and write"
# solo sobre el repo Chronos. Opcional: sin él, el botón se deshabilita. ---
GITHUB_DISPATCH_TOKEN=

# --- Protege /api/health y otros endpoints de cron (Vercel lo envía como Bearer). Mínimo 16 caracteres ---
CRON_SECRET=
