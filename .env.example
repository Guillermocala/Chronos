# Copia este archivo a .env.local (o usa `npx vercel env pull .env.local`).
# Nunca subas valores reales al repositorio.

# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Acceso: único email autorizado para iniciar sesión ---
ALLOWED_EMAIL=

# --- Backups manuales: token fine-grained con Actions: write sobre el repo Chronos ---
GITHUB_DISPATCH_TOKEN=

# --- Protege /api/health y otros endpoints de cron (Vercel lo envía como Bearer) ---
CRON_SECRET=
